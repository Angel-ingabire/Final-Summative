{
  "name": "amatasettle",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Offline-ready, signed dairy delivery settlements for cooperative finance on Ethereum",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:local": "hardhat run scripts/deploy.js",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "setup:sepolia": "hardhat run scripts/setup.js --network sepolia",
    "demo:local": "hardhat run scripts/demo-local.js",
    "report:pdf": "python scripts/generate_report_pdf.py",
    "presentation": "node scripts/generate_presentation.js",
    "build:web": "npm --prefix frontend run build",
    "dev:web": "npm --prefix frontend run dev"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "dotenv": "^16.6.1",
    "ethers": "^6.17.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.2.2",
    "@nomicfoundation/hardhat-mocha": "^4.0.1",
    "chai": "^5.3.3",
    "hardhat": "^3.22.0",
    "mocha": "^12.0.0",
    "pptxgenjs": "^4.0.1"
  }
}
